&lt;span style=&quot;background-color: rgb(18, 19, 20); color: rgb(78, 201, 176);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;background-color: rgb(18, 19, 20); color: rgb(78, 201, 176);&quot;&gt;ThreadPoolBatchExecutor&lt;/span&gt;&lt;/div&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify; color: rgb(187, 190, 191); background-color: rgb(18, 19, 20); line-height: 19px;&quot;&gt;&lt;span style=&quot;color: rgb(78, 201, 176); background-color: rgb(18, 19, 20);&quot;&gt; or&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(187, 190, 191); background-color: rgb(18, 19, 20); line-height: 19px;&quot;&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: rgb(18, 19, 20); color: rgb(78, 201, 176);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;background-color: rgb(18, 19, 20); color: rgb(78, 201, 176);&quot;&gt;SerialBatchExecutor&lt;/span&gt;&lt;/div&gt;&lt;span style=&quot;color: rgb(78, 201, 176); background-color: rgb(18, 19, 20);&quot;&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: rgb(18, 19, 20); color: rgb(78, 201, 176);&quot;&gt;4.&lt;/span&gt;&lt;span style=&quot;background-color: rgb(18, 19, 20); color: rgb(78, 201, 176);&quot;&gt;PlanValidator()&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
